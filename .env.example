# Application settings
APP_NAME=ScheduleService
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/schedule_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=schedule_db

# Observability / Grafana (docker-compose.observability.yml)
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-prod
